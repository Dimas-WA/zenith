# ── Wallet ────────────────────────────────────────────────────────────────────
WALLET_PRIVATE_KEY=your_base58_private_key_here

# ── Solana RPC ─────────────────────────────────────────────────────────────────
RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Option A: OpenRouter (default — akses semua model via 1 key)
OPENROUTER_API_KEY=sk-or-your_openrouter_key_here

# Option B: LM Studio (local) — uncomment these and comment out OPENROUTER_API_KEY
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=your-model-name-from-lmstudio

# ── Provider API Keys ─────────────────────────────────────────────────────────
# Isi key untuk provider yang lo pake. Provider yang ga dipake boleh kosong.
#
# DeepSeek (api.deepseek.com)
# Models: deepseek-v4-flash ($0.14/M), deepseek-v4-pro ($0.435/M)
DEEPSEEK_API_KEY=

# XiaoMiMo (api.xiaomimimo.com/v1)
# Models: mimo-v2.5 ($0.14/M), mimo-v2.5-pro ($0.435/M), off-v2-flash ($0.10/M)
XIAOMIMO_API_KEY=

# AIMurah — Indonesian proxy (openagentic.id)
# Models: claude-sonnet-4.5, claude-haiku-4.5, gpt-4o, gpt-4o-mini, gemini-2.0-flash
AIMURAH_API_KEY=

# Direct provider keys (optional)
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIza...
# GROQ_API_KEY=gsk_...
# XAI_API_KEY=xai-...

# ── Per-Role Provider (optional) ─────────────────────────────────────────────
# Beda provider per role. Providers: openrouter, deepseek, xiaomimo, aimurah,
# anthropic, google, groq, together, xai, local
#
# Contoh setup optimal (murah + kuat):
#   Screening  → deepseek-v4-pro (reasoning kuat, $0.435/M)
#   Management → off-v2-flash (paling murah, $0.10/M, fast)
#   General    → mimo-v2.5 (balance, $0.14/M)
#
# SCREENING_PROVIDER=deepseek
# SCREENING_MODEL=deepseek-v4-pro
#
# MANAGEMENT_PROVIDER=xiaomimo
# MANAGEMENT_MODEL=off-v2-flash
#
# GENERAL_PROVIDER=xiaomimo
# GENERAL_MODEL=mimo-v2.5

# ── API Keys ───────────────────────────────────────────────────────────────────
HELIUS_API_KEY=your_helius_api_key_here
LPAGENT_API_KEY=your_lpagent_api_key_here

# ── Telegram Notifications (optional) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# ── Dangerous admin actions (disabled by default) ─────────────────────────────
ALLOW_SELF_UPDATE=false

# ── Misc ───────────────────────────────────────────────────────────────────────
DRY_RUN=false
LOG_LEVEL=info
